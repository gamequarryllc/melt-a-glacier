# Pinned versions of the engine and the native ad / store plugins.
# CI (GitHub Actions, Codemagic) and tools/fetch_plugins.sh read this file.
# When you bump GODOT_VERSION, the AdMob plugin needs a matching
# android-template-v<GODOT_VERSION>.zip in its release (check its Releases page).
GODOT_VERSION=4.7.2
ADMOB_PLUGIN_VERSION=v5.1.0
REVENUECAT_PLUGIN_VERSION=2.6.0
